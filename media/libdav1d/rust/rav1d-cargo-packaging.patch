--- a/Cargo.toml
+++ b/Cargo.toml
@@ -1,6 +1,3 @@
-[workspace]
-members = [".", "tools"]
-default-members = [".", "tools"]

 [package]
 name = "rav1d"
@@ -15,7 +12,7 @@
 exclude = ["*.c", "*.h", "!src/arm/asm-offsets.h", "*.in", "meson*", "tests/", "doc/", "package/"]

 [lib]
-crate-type = ["staticlib", "rlib"]
+crate-type = ["rlib"]

 [dependencies]
 assert_matches = "1.5.0"
@@ -25,7 +22,7 @@
 cfg-if = "1.0.0"
 libc = "0.2"
 parking_lot = "0.12.2"
-paste = "1.0.14"
+paste = "1.0.11"
 raw-cpuid = "11.0.1"
 static_assertions = "1.1.0"
 strum = { version = "0.27", features = ["derive"] }
@@ -45,26 +42,3 @@
 bitdepth_8 = []
 bitdepth_16 = []

-[profile.dev]
-panic = "abort"
-
-[profile.opt-dev]
-# The debug builds run tests very slowly so this profile keeps debug assertions
-# while enabling basic optimizations. The profile is not suitable for debugging.
-inherits = "dev"
-opt-level = 1
-
-[profile.release]
-codegen-units = 1
-panic = "abort"
-lto = "fat"
-
-[profile.release-with-debug]
-inherits = "release"
-debug = "line-tables-only"
-
-[profile.checked-release]
-# Close to a release build, but with all checks enabled.
-inherits = "dev"
-opt-level = 2
-codegen-units = 16
