features = []
if CONFIG["MOZ_MEMORY"]:
    features += ["moz_memory"]
RustLibrary("moz_rav1d", features)
FINAL_LIBRARY = "gkcodecs"

OS_LIBS += CONFIG["DL_LIBS"]
if CONFIG["OS_ARCH"] == "Darwin":
    OS_LIBS += ["-liconv", "-lresolv"]
elif CONFIG["OS_ARCH"] == "WINNT":
    OS_LIBS += ["advapi32", "bcrypt", "ntdll", "synchronization", "userenv", "ws2_32"]
elif CONFIG["OS_TARGET"] == "Android":
    OS_LIBS += ["log", "m"]
else:
    OS_LIBS += ["m", "pthread"]
